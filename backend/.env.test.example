# ---------------------------------------------------------------------------
# TEST — vitest / integration suite.
#
# Copy to `.env.test`. Picked up automatically because vitest sets NODE_ENV=test.
#
# WARNING — read before creating this file
# ---------------------------------------
# If `.env.test` exists it takes precedence over `.env`. If you copy the line
# below verbatim and then run the suite, every test that touches the database runs
# against a local PostgreSQL. That is the intent.
#
# The opposite mistake is worse: pointing `DATABASE_URL` at the production
# database makes `npm run prisma:reset` and the integration suite destructive
# against live orders. Never paste a production host here.
#
# `tests/integration/_safety.ts` refuses to run the destructive suites unless
# `TEST_DATABASE_URL` points at a genuinely disposable database. Keep that gate.
# ---------------------------------------------------------------------------
NODE_ENV=test
PORT=5001

# Disposable local database. The integration suite requires a SEPARATE
# TEST_DATABASE_URL and truncates between suites, so this must be a database you
# are willing to lose.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vedhicfoods_test?schema=public

JWT_SECRET=test_only_jwt_secret_change_me_32_characters_minimum
JWT_EXPIRES_IN=1h

# The dev servers are still the browser origin during manual QA of a test build.
FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5174

TRUST_PROXY=false

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=vedhifoods-media-dev
AWS_S3_PUBLIC_BASE_URL=

# Deliberately unset. The rate limiter uses its in-process store and
# `__resetRateLimitStoreForTests()` clears it, which is the correct behaviour for
# a single test process and avoids a Redis dependency in CI.
REDIS_URL=

DATABASE_POOL_SIZE=2
DATABASE_CONNECT_TIMEOUT_S=5
DATABASE_SOCKET_TIMEOUT_S=10
DATABASE_PGBOUNCER=

SECRETS_MANAGER_SECRET_ID=

REQUEST_TIMEOUT_MS=10000
HEADERS_TIMEOUT_MS=11000
KEEP_ALIVE_TIMEOUT_MS=10000
SHUTDOWN_GRACE_MS=5000

# No outbound email from a test run. 'brevo' with a blank key makes the transport
# log a simulated dispatch instead of spending mail quota.
EMAIL_PROVIDER=brevo
SES_REGION=
SES_SENDER_EMAIL=
SES_SENDER_NAME=Vedhic Foods
SES_CONFIGURATION_SET=

# No ops alerts and no SNS topic in a test run; verification stays on by default.
ADMIN_NOTIFICATION_EMAIL=
SNS_EMAIL_TOPIC_ARN=
SNS_VERIFY_SIGNATURE=true

BREVO_API_KEY=
BREVO_SENDER_EMAIL=care@vedhicfoods.com
BREVO_SENDER_NAME=Vedhic Foods

RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

ENCRYPTION_KEY=test_only_encryption_key_change_me_32_bytes!

# 'fatal' is the quietest level the LOG_LEVEL enum accepts. There is no 'silent'
# value — setting one makes the schema reject it and the process exits, so the
# suite would fail to boot rather than print less.
LOG_LEVEL=fatal