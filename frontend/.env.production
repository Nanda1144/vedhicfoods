# ---------------------------------------------------------------------------
# PRODUCTION build — storefront (vedhicfoods.com).
#
# TRACKED IN GIT ON PURPOSE. The root `.gitignore` excludes `.env.*` and
# re-admits only `.env.*.example`; this file is explicitly re-admitted because it
# contains no secret. Vite inlines every `VITE_*` variable into the JavaScript
# bundle at build time, so anything placed here is public by definition. Never
# put a credential here.
#
# This file exists so that `npm run build` produces a bundle that talks to
# production *by default*. The alternative — relying on a build machine to export
# VITE_API_URL — means a deploy that forgets it silently produces a site pointed
# at http://localhost:5000, which loads, renders, and fails on every write.
# ---------------------------------------------------------------------------

# Base URL of the backend, including the /api/v1 prefix.
# Hosted behind the ALB created by backend/infra/cloudformation/vedhicfoods-edge.yaml.
# MUST be https: `src/services/http.ts` refuses to build a production bundle that
# points anywhere else.
VITE_API_URL=https://api.vedhicfoods.com/api/v1

# Both fallbacks stay OFF in production. The storefront must report an outage,
# not quietly render the sample catalogue in src/data/products.ts, because a
# visitor seeing placeholder products has no way to tell that from a bug.
VITE_ENABLE_PRODUCT_FALLBACK=false
VITE_ENABLE_SETTINGS_FALLBACK=false