# ---------------------------------------------------------------------------
# DEVELOPMENT — local machine only.
#
# Copy to `.env.development`. Real values are never committed; the root
# `.gitignore` excludes `.env.*` and re-admits only `.env.*.example`.
#
# Loaded by `src/config/env.ts` when NODE_ENV is unset or `development`.
# Precedence, highest first:
#   1. real environment variables (`npm` scripts, `docker run -e`, CI)
#   2. `.env.development`   <- this file
#   3. `.env`               <- legacy single-file setup, fallback only
#
# Nothing here is production-relevant and none of these values may be reused for
# a deployed environment.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Local PostgreSQL. Deliberately NOT a Supabase/RDS host: pointing a development
# session at the production database means an `npm run prisma:reset` destroys live
# orders.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vedhicfoods?schema=public

# Non-secret, throwaway signing key. Satisfies the 32-character minimum so the
# app boots, and is rejected outright when NODE_ENV=production.
JWT_SECRET=dev_only_jwt_secret_change_me_32_characters_minimum
JWT_EXPIRES_IN=7d

# Local Vite dev servers. Storefront runs on 5173, admin portal on 5174.
FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5174

# No proxy in front of the app locally, so nothing is trusted. See the header
# comment in `.env.example` for what each value means.
TRUST_PROXY=false

AWS_REGION=ap-south-1
# Leave both blank locally: the AWS SDK picks them up from the developer machine's
# profile, and setting them here would shadow a `aws sso login` session.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=vedhifoods-media-dev
# Optional. Set to a CloudFront/CDN origin when the bucket is private; leave
# blank to use the direct S3 URL (public-read bucket / local dev).
AWS_S3_PUBLIC_BASE_URL=

# No Redis locally. The rate limiter falls back to its in-process store, which is
# correct for a single process and is explicitly refused in production.
REDIS_URL=

DATABASE_POOL_SIZE=5
DATABASE_CONNECT_TIMEOUT_S=10
DATABASE_SOCKET_TIMEOUT_S=30
DATABASE_PGBOUNCER=

# Only needed when running the built image outside ECS. Unset on Fargate: the task
# definition injects secrets as environment variables and no code is involved.
SECRETS_MANAGER_SECRET_ID=

REQUEST_TIMEOUT_MS=60000
HEADERS_TIMEOUT_MS=66000
KEEP_ALIVE_TIMEOUT_MS=65000
SHUTDOWN_GRACE_MS=25000

# 'auto' prefers SES and falls back to Brevo. Locally there are no AWS
# credentials, so Brevo is what actually sends the mail.
EMAIL_PROVIDER=auto
SES_REGION=
SES_SENDER_EMAIL=
SES_SENDER_NAME=Vedhic Foods
SES_CONFIGURATION_SET=

ADMIN_NOTIFICATION_EMAIL=
# No SNS topic locally; the webhook is only meaningful in a deployed environment.
SNS_EMAIL_TOPIC_ARN=
# Local runs keep verification on; the only caller would be a signed SNS message.
SNS_VERIFY_SIGNATURE=true

# Brevo dashboard -> SMTP & API -> API Keys. The sender must be verified first.
# Without a key the app logs a simulated dispatch instead of sending.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=care@vedhicfoods.com
BREVO_SENDER_NAME=Vedhic Foods

# Razorpay *test* keys only. Production uses `rzp_live_*` from Secrets Manager.
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# Throwaway 32-byte key for encrypting stored payment credentials. The same key
# must never be reused in production: rotating it without re-encrypting the
# existing `PaymentSettings` row makes those credentials permanently unreadable.
ENCRYPTION_KEY=dev_only_encryption_key_change_me_32_bytes!!

LOG_LEVEL=debug