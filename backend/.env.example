# =============================================================================
# FULL KEY REFERENCE for the backend API.
#
# DEPLOYMENT (Render): do NOT upload this file. Use it as the checklist of
# variable NAMES and set each one in Render -> service -> Environment. For a real
# deploy copy the values from `backend/.env.production.example` instead. Render
# does not read any .env file; real environment variables always win.
# Full mapping: docs/DEPLOYMENT_ENV.md
# =============================================================================
# Application Environment
NODE_ENV=development
PORT=5000

# PostgreSQL Database (Amazon RDS in production, local postgres in development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vedhicfoods?schema=public

# Security & Authentication
JWT_SECRET=vedhicfoods_jwt_secret_must_be_at_least_32_characters_long_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5173

# Reverse-proxy trust. Determines which X-Forwarded-For hop Express treats as the
# real client address — i.e. what every rate limiter keys on and what is recorded
# as the source IP in the audit log.
#
# SECURITY: this was hardcoded to 1, which trusted a client-supplied
# X-Forwarded-For whenever the deployment did not actually have exactly one proxy
# in front of it, voiding the login / reset / checkout rate limits. Declare the
# real topology instead.
#
#   false        no proxy in front (direct exposure) — the local default
#   1            exactly one proxy hop (typical: a single AWS ALB)
#   2            two hops (ALB -> CloudFront)
#   loopback     trust only the local machine
#   10.0.0.0/8   trust only hops inside these ranges (comma-separated list allowed)
#
# Production REFUSES TO BOOT while this is unset.
TRUST_PROXY=false

# AWS Services Configuration (Region: Mumbai / ap-south-1)
# Note: In production AWS EC2 / ECS / App Runner, use IAM Roles instead of static keys
# AWS keys are used for S3 media storage only. Transactional email is SES in production.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=vedhifoods-media-production
# Optional. Set to a CloudFront/CDN origin when the bucket is private; leave
# blank to use the direct S3 URL (public-read bucket / local dev).
AWS_S3_PUBLIC_BASE_URL=

# Shared Redis for rate limiting.
#
# SECURITY: required in production. express-rate-limit's default store is
# per-process, so with N instances the effective limit is `configured x N` — the
# login limit silently becomes 20x the task count. The app REFUSES TO BOOT in
# production without this value rather than degrading quietly.
# Use ElastiCache Redis or VPC endpoints; do not expose it publicly.
REDIS_URL=redis://localhost:6379

# Connection pooling. Total connections = DATABASE_POOL_SIZE x task count, and
# that must stay under the RDS instance's max_connections.
#   5 x 6 tasks = 30   (comfortably inside db.t4g.medium's ~420)
# Raise the task count and this must be re-checked.
DATABASE_POOL_SIZE=5
DATABASE_CONNECT_TIMEOUT_S=10
DATABASE_SOCKET_TIMEOUT_S=30
# Set when connecting through PgBouncer / Supabase transaction mode so Prisma
# disables prepared statements. Auto-detected for known pooler hosts.
DATABASE_PGBOUNCER=

# AWS Secrets Manager (OPTIONAL).
#
# On ECS/Fargate leave this UNSET: the task definition injects secrets as
# environment variables, which needs no code.
# Set it only when running the image somewhere without an ECS agent (EC2,
# Beanstalk, App Runner, CI). It is loaded by dist/bootstrap.js BEFORE
# config/env.ts validates process.env, so the values are present in time.
# The secret must be a JSON object of KEY -> "value" string pairs.
# Failure to load is fatal; it never falls back to a development default.
SECRETS_MANAGER_SECRET_ID=

# HTTP server timeouts.
#
# REQUEST_TIMEOUT_MS must be greater than the slowest real operation (invoice PDF
# generation + S3 upload) and LESS than the load balancer idle timeout, otherwise
# the proxy drops the connection while the app is still working and the client
# sees a 502 for a request that actually succeeded.
# SHUTDOWN_GRACE_MS must be LESS than the orchestrator's termination grace period
# (ECS stopTimeout / K8s terminationGracePeriodSeconds).
REQUEST_TIMEOUT_MS=60000
HEADERS_TIMEOUT_MS=66000
KEEP_ALIVE_TIMEOUT_MS=65000
SHUTDOWN_GRACE_MS=25000

# Email provider selection: 'ses' (AWS, production) | 'brevo' | 'auto'.
# 'auto' prefers SES and falls back to Brevo, which keeps local development
# working without AWS credentials while production uses the in-region,
# IAM-scoped transport instead of a long-lived API key.
EMAIL_PROVIDER=auto

# Amazon SES (production transport).
# The sender MUST be on a domain verified in this AWS account, or an individually
# verified address. SES_REGION is optional — when unset the SDK follows
# AWS_REGION. Without a sender the app logs an ERROR at startup and drops
# transactional mail rather than sending from an unverified address.
SES_REGION=
SES_SENDER_EMAIL=
SES_SENDER_NAME=Vedhic Foods
# Optional configuration set. Required for bounce/complaint events to reach
# CloudWatch, which is what makes the bounce-rate alarm possible.
SES_CONFIGURATION_SET=

# Optional ops inbox for paid-order / failure alerts. When unset the SES/Brevo
# sender address is used, so no deployment is forced to set it.
ADMIN_NOTIFICATION_EMAIL=

# SNS topic that receives SES bounce/complaint events. The webhook uses it to
# reject messages from any other publisher before suppressing an address.
SNS_EMAIL_TOPIC_ARN=
# Verify the SNS message signature on the inbound bounce/complaint webhook.
# Leave true outside throwaway environments; false lets a forged POST suppress
# arbitrary recipients.
SNS_VERIFY_SIGNATURE=true

# Durable email outbox. When true, queued email is written to the `email_outbox`
# table and delivered by a background worker with retry, so mail survives
# restarts and rolling deploys. Defaults to on outside unit tests. The batch is
# the maximum rows one worker tick claims.
EMAIL_OUTBOX_ENABLED=true
EMAIL_OUTBOX_INTERVAL_MS=15000
EMAIL_OUTBOX_BATCH_SIZE=25

# Abandoned-checkout reservation reaper. Orders left in PENDING_PAYMENT longer
# than RESERVATION_TTL_MS release their held stock and are cancelled. Defaults on.
RESERVATION_SWEEP_ENABLED=true
RESERVATION_TTL_MS=1800000
RESERVATION_SWEEP_INTERVAL_MS=300000
RESERVATION_SWEEP_BATCH=100

# Brevo - fallback / local development transport.
# API key: Brevo dashboard -> SMTP & API -> API Keys -> Generate a new API key.
# The sender address/name MUST be verified first (SMTP & API -> Senders & Domains),
# otherwise dispatch is rejected. Without a key the app logs a simulated dispatch
# in development instead of sending.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=care@vedhicfoods.com
BREVO_SENDER_NAME=Vedhic Foods

# Razorpay Payment Gateway (OPTIONAL bootstrap fallback).
# The supported flow is Admin -> Payment Settings, which stores the credentials
# encrypted in the database and takes effect without a redeploy. These env vars
# are only a first-boot fallback; once NODE_ENV=production a placeholder value
# counts as "not configured".
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# General-purpose encryption key (AES-256-GCM, used by database/encryption.ts).
# Production and staging REFUSE TO BOOT with this placeholder value or without
# an ENCRYPTION_KEY at all. Generate a unique 32+ character secret and inject it
# via AWS Secrets Manager / SSM Parameter Store, exactly like JWT_SECRET.
# Rotating it later requires re-encrypting stored payment credentials.
ENCRYPTION_KEY=vedhicfoods_secure_32bit_key_2026_aes!

# Dedicated key for admin-managed payment credentials (v2 AES-256-GCM). Required
# in production/staging before an admin can SAVE credentials; development/test
# fall back to ENCRYPTION_KEY. Generate a unique 32+ character secret. Legacy
# rows encrypted with ENCRYPTION_KEY stay readable and are re-encrypted on the
# next admin save.
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=vedhicfoods_payment_credentials_key_32_bytes!

# Logging
LOG_LEVEL=info
