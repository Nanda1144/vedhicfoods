# Frontend environment configuration.
# Copy to `.env` and adjust. NEVER commit a populated `.env`.
#
# DEPLOYMENT (Vercel): don't upload any file. Add the VITE_* keys below in
# Vercel -> Project -> Settings -> Environment Variables (scope: Production).
# Vercel vars override `.env.production`. See docs/DEPLOYMENT_ENV.md.

# Base URL of the backend API, including the /api/v1 prefix.
VITE_API_URL=http://localhost:5000/api/v1

# --- Product catalog data source -------------------------------------------
# The storefront renders products from the backend only. When the API is
# unreachable the page shows an error state with a retry button.
#
# Set to `true` ONLY for UI work with no backend running: it restores the
# prototype behaviour of silently falling back to the sample catalogue in
# src/data/products.ts. Leave it unset/false in production, otherwise the site
# will display placeholder products instead of reporting an outage.
VITE_ENABLE_PRODUCT_FALLBACK=false

# Same idea for website/contact settings (branding, phone, address, socials).
# `true` lets the app render from its cached copy when GET /settings fails.
VITE_ENABLE_SETTINGS_FALLBACK=false

# --- Homepage hero background images (fallback) ----------------------------
# The storefront cross-fades hero images behind the headline. Resolution order:
#   1. Admin console (Website Settings > Homepage Hero) image list — always wins
#   2. VITE_HERO_IMAGES override below if set
#   3. Auto-discovered images from the repo-root `assests/` folder
#      (drop jpg/png/webp/avif files in there and restart the dev server).
#
# Admin-managed images always win, so the client can change the hero artwork
# without a rebuild. Only set this to pin a specific list during development:
# VITE_HERO_IMAGES=/hero/hero-1.jpg,https://cdn.example.com/hero-3.jpg