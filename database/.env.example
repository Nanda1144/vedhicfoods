# Database / seed environment configuration.
#
# Copy to `.env` and fill in real values. NEVER commit a populated `.env`.
# This folder's `.env` is consumed by the Prisma migration and seed scripts.
# The keys below are exactly the keys that `database/.env` sets.

# PostgreSQL connection string used by the seed/migration scripts.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vedhicfoods?schema=public

# Seed account passwords. Use throwaway values; never reuse real credentials.
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
SEED_CUSTOMER_PASSWORD=
