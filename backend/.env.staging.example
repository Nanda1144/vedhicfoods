# ---------------------------------------------------------------------------
# STAGING — production-shaped, non-production data.
#
# Copy to `.env.staging`. Staging is the rehearsal for production, so it differs
# from production in exactly two ways: the data it points at, and the frontend
# origins (a staging storefront can still be served over plain HTTP while ACM
# validation is in flight, so `NODE_ENV=production`'s https-only guard does not
# apply here).
#
# Precedence, highest first:
#   1. real environment variables
#   2. `.env.staging`
#   3. `.env`
#
# DO NOT reuse staging secrets in production. A staging JWT_SECRET means a
# staging token verifies against the production API if the two environments ever
# share a signing key, and a staging `ENCRYPTION_KEY` is a key that has already
# touched a payment credential.
# ---------------------------------------------------------------------------
NODE_ENV=staging
PORT=5000

# A SEPARATE database instance from production. Staging runs migrations and seed
# scripts that truncate tables; on production those are live orders.
DATABASE_URL=postgresql://REPLACE_ME_STAGING_DB_USER:REPLACE_ME_STAGING_DB_PASSWORD@REPLACE_ME_STAGING_DB_HOST:5432/vedhicfoods?sslmode=require

# Both are placeholders. Generate real ones and store them in Secrets Manager:
#   openssl rand -base64 48
# The `vedhicfoods_jwt_secret_...` value in `.env.example` is published in this
# repository and is rejected when NODE_ENV=production.
JWT_SECRET=REPLACE_ME_STAGING_JWT_SECRET_min_32_chars_openssl_rand_base64_48
JWT_EXPIRES_IN=7d

# Staging storefront. Set these to the staging hostnames, e.g.
#   https://staging.vedhicfoods.com
#   https://admin-staging.vedhicfoods.com
# Do not leave them on localhost: it hides origin-misconfiguration bugs until
# they are discovered in production.
FRONTEND_URL=https://REPLACE_ME_STAGING_FRONTEND_ORIGIN
ADMIN_FRONTEND_URL=https://REPLACE_ME_STAGING_ADMIN_ORIGIN

# Exactly one Application Load Balancer in front. `awsvpc` networking means there
# is no host-level NAT hop to account for.
TRUST_PROXY=1

AWS_REGION=ap-south-1
# Blank on purpose: the task role supplies credentials. Setting these makes the SDK
# prefer static keys over the role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=REPLACE_ME_STAGING_S3_BUCKET

# ElastiCache or VPC endpoint. Never a public RDS/Redis address.
REDIS_URL=redis://REPLACE_ME_STAGING_REDIS_HOST:6379

DATABASE_POOL_SIZE=5
DATABASE_CONNECT_TIMEOUT_S=10
DATABASE_SOCKET_TIMEOUT_S=30
DATABASE_PGBOUNCER=

# Unset on Fargate/EC2-with-agent: the task definition injects the secrets. Set it
# only where there is no ECS agent to do that injection.
SECRETS_MANAGER_SECRET_ID=

REQUEST_TIMEOUT_MS=60000
HEADERS_TIMEOUT_MS=66000
KEEP_ALIVE_TIMEOUT_MS=65000
SHUTDOWN_GRACE_MS=25000

EMAIL_PROVIDER=auto
SES_REGION=ap-south-1
# Staging mail must not reach real customers. Either leave the sender blank (the
# app drops the message and logs) or point it at a verified +address you control.
SES_SENDER_EMAIL=
SES_SENDER_NAME=Vedhic Foods (Staging)
SES_CONFIGURATION_SET=vedhicfoods-staging

ADMIN_NOTIFICATION_EMAIL=
SNS_EMAIL_TOPIC_ARN=
SNS_VERIFY_SIGNATURE=true

BREVO_API_KEY=
BREVO_SENDER_EMAIL=care@vedhicfoods.com
BREVO_SENDER_NAME=Vedhic Foods

# Razorpay *test* mode. Live keys in staging charge real cards.
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME_STAGING_RAZORPAY_WEBHOOK_SECRET

ENCRYPTION_KEY=REPLACE_ME_STAGING_ENCRYPTION_KEY_min_32_chars

LOG_LEVEL=info