{
    "name":  "vedhicfoods-backend",
    "version":  "1.0.0",
    "description":  "Production-ready Node.js/TypeScript backend for Vedhic Foods organic e-commerce platform.",
    "main":  "dist/server.js",
    "scripts":  {
                    "dev":  "tsx watch src/server.ts",
                    "build":  "tsc",
                    "start":  "node dist/bootstrap.js",
                    "lint": "oxlint",
                    "test":  "vitest run",
                    "test:unit":  "vitest run tests/unit",
                    "test:integration":  "vitest run tests/integration",
                    "prisma:generate":  "npm run prisma:generate --prefix .. --workspace vedhicfoods-database",
                    "prisma:migrate":  "npm run prisma:migrate --prefix .. --workspace vedhicfoods-database",
                    "prisma:deploy":  "npm run prisma:deploy --prefix .. --workspace vedhicfoods-database",
                    "prisma:status":  "npm run prisma:status --prefix .. --workspace vedhicfoods-database",
                    "prisma:seed":  "npm run prisma:seed --prefix .. --workspace vedhicfoods-database",
                    "prisma:studio":  "npm run prisma:studio --prefix .. --workspace vedhicfoods-database"
                },
    "dependencies":  {
                         "@aws-sdk/client-s3":  "^3.758.0",
                         "@aws-sdk/client-secrets-manager":  "^3.758.0",
                         "@aws-sdk/client-ses":  "^3.1146.0",
                         "@aws-sdk/s3-request-presigner":  "^3.1143.0",
                         "@prisma/client":  "^6.4.1",
                         "bcryptjs":  "^3.0.2",
                         "compression":  "^1.8.0",
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.4.7",
                         "express":  "^4.21.2",
                         "express-rate-limit":  "^7.5.0",
                         "helmet":  "^8.0.0",
                         "jsonwebtoken":  "^9.0.2",
                         "pdfkit":  "^0.20.2",
                         "pino":  "^9.6.0",
                         "pino-http":  "^10.4.0",
                         "rate-limit-redis":  "^4.3.1",
                         "razorpay":  "^2.9.5",
                         "redis":  "^4.7.1",
                         "uuid":  "^11.1.0",
                         "vedhicfoods-database":  "*",
                         "zod":  "^3.24.2"
                     },
    "devDependencies":  {
                            "@types/bcryptjs":  "^2.4.6",
                            "@types/compression":  "^1.7.5",
                            "@types/cors":  "^2.8.17",
                            "@types/express":  "^5.0.0",
                            "@types/jsonwebtoken":  "^9.0.8",
                            "@types/node":  "^22.13.5",
                            "@types/pdfkit":  "^0.17.6",
                            "@types/supertest":  "^6.0.2",
                            "@types/uuid":  "^10.0.0",
                            "oxlint":  "^1.81.0",
                            "pino-pretty":  "^13.0.0",
                            "prisma":  "^6.4.1",
                            "supertest":  "^7.0.0",
                            "tsx":  "^4.19.3",
                            "typescript":  "^5.7.3",
                            "vitest":  "^3.0.6"
                        }
}