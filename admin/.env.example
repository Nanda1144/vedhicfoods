# Admin portal environment configuration.
# Copy to `.env` and adjust. NEVER commit a populated `.env`.
#
# `.env.production` is tracked deliberately — it holds no secret and is what makes
# `npm run build` target the production API without depending on the build host's
# environment.

# Base URL of the backend API, including the /api/v1 prefix.
# Production: https://api.vedhicfoods.com/api/v1
VITE_API_URL=http://localhost:5000/api/v1