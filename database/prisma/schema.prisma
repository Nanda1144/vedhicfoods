model Testimonial {
  id              String   @id @default(uuid())
  name            String
  location        String
  quote           String
  rating          Int      @default(5)
  avatarUrl       String?
  avatarInitials  String?
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
  @@index([isFeatured, sortOrder])
  @@map("testimonials")
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String   @default("General")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, sortOrder])
  @@index([isActive])
  @@map("faqs")
}

// Customer-submitted product reviews. New rows land `isApproved: false` and
// appear on the storefront only once a staff member moderates them; a review is
// never editable by its author to prevent retroactive rewriting of visible content.
model ProductReview {
  id          String   @id @default(uuid())
  productId   String
  userId      String?
  authorName  String
  authorEmail String?
  rating      Int
  title       String
  body        String
  isVerified  Boolean  @default(false)
  isApproved  Boolean  @default(false)
  isRejected  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull, map: "product_reviews_user_id_fkey")

  @@index([productId, isApproved])
  @@index([userId], map: "product_reviews_user_id_idx")
  @@index([isApproved, createdAt])
  @@map("product_reviews")
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  source    String   @default("footer")
  isActive  Boolean  @default(true)
  unsubscribedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("newsletter_subscribers")
}

// Durable transactional email outbox. Replaces the process-local retry queue so
// a rolling deploy or crash cannot lose queued password-reset, order-confirmation
// or invoice mail; any instance can drain it. See EmailOutboxWorker.
model EmailOutbox {
  id                String            @id @default(uuid())
  toAddress         String            @map("to_address")
  toName            String?           @map("to_name")
  subject           String
  htmlBody          String            @map("html_body")
  textBody          String?           @map("text_body")
  fromEmail         String?           @map("from_email")
  templateName      String            @map("template_name")
  attachmentName    String?           @map("attachment_name")
  attachmentContent String?           @map("attachment_content")
  status            EmailOutboxStatus @default(PENDING)
  attempts          Int               @default(0)
  maxAttempts       Int               @default(3) @map("max_attempts")
  lastError         String?           @map("last_error")
  dedupeKey         String?           @unique @map("dedupe_key")
  nextAttemptAt     DateTime          @default(now()) @map("next_attempt_at")
  lockedAt          DateTime?         @map("locked_at")
  sentAt            DateTime?         @map("sent_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@map("email_outbox")
}

enum EmailOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}
