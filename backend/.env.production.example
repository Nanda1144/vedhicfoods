# ---------------------------------------------------------------------------
# PRODUCTION
#
# Copy to `.env.production` ONLY when running outside ECS/EC2 (App Runner, a
# container on a workstation, a CI job that starts the image directly).
#
# On Fargate this file is irrelevant: the task definition supplies every value
# below through `environment` and `secrets`, and real environment variables
# always override any dotenv file. See `backend/infra/ecs-task-definition.json`
# for the authoritative production values.
#
# DEPLOYMENT (Render): use this file as the key list and paste each variable into
# Render -> service -> Environment. Render terminates TLS at its own proxy, so:
#   TRUST_PROXY=1
#   FRONTEND_URL / ADMIN_FRONTEND_URL = the https Vercel domains
#   REDIS_URL required (Render Key Value instance) when NODE_ENV=production
#   AWS_* not needed unless S3 media upload is used
# Full mapping: docs/DEPLOYMENT_ENV.md
# ---------------------------------------------------------------------------
# THIS FILE MUST NOT CONTAIN SECRETS.
#
# Anything marked REPLACE_ME below is a value you must obtain from Secrets
# Manager, never invent and never paste from a chat window or a ticket. The
# values marked "not applicable" are genuinely unset in production: the AWS SDK
# picks up the task role, and there is no local `.env` to read.
#
# The REPLACE_ME secrets that must be fetched at run time:
#   DATABASE_URL           must contain sslmode=require
#   JWT_SECRET             openssl rand -base64 48
#   ENCRYPTION_KEY         32+ chars; rotating it requires re-encrypting the
#                          PaymentSettings row first, or stored Razorpay
#                          credentials become permanently unreadable
#   PAYMENT_CREDENTIALS_ENCRYPTION_KEY
#                          32+ chars; the dedicated key for admin-managed
#                          payment credentials. Required before an admin can
#                          SAVE credentials in production. Rotating it requires
#                          re-encrypting the PaymentSettings row first.
#   RAZORPAY_KEY_* / RAZORPAY_WEBHOOK_SECRET
#                          OPTIONAL bootstrap fallback. Prefer configuring the
#                          gateway from Admin -> Payment Settings, which stores
#                          the credentials encrypted in the DB. When set, only
#                          rzp_live_* is valid in production; a placeholder
#                          counts as "not configured".
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

DATABASE_URL=postgresql://REPLACE_ME_DB_USER:REPLACE_ME_DB_PASSWORD@REPLACE_ME_RDS_ENDPOINT:5432/vedhicfoods?sslmode=require

JWT_SECRET=REPLACE_ME_PRODUCTION_JWT_SECRET_openssl_rand_base64_48
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# CORS — THE TWO VALUES THAT DEFINE THE PRODUCTION TRUST BOUNDARY.
#
# These must be the real, https, public storefront and admin origins. They are the
# complete allowlist: `buildAllowedOrigins()` adds nothing in production, and any
# other browser origin is refused. There is no wildcard and no fallback.
#
# `src/config/env.ts` refuses to boot when either value is not `https://`, is
# `*`, or points at a loopback / reserved host (`*.example`, `*.invalid`,
# `*.test`, `*.localhost`) — the last because such a host cannot be registered in
# DNS and the resulting failure is silent.
#
# The customer store and the admin portal are separate origins on purpose. If the
# admin portal were served from the storefront origin, every storefront XSS would
# also inherit admin session reach. Keep them apart and both listed here.
# ---------------------------------------------------------------------------
FRONTEND_URL=https://vedhicfoods.com
ADMIN_FRONTEND_URL=https://admin.vedhicfoods.com

# One Application Load Balancer terminates TLS in front of the app. `awsvpc`
# networking adds no further hop. Set 2 only if CloudFront sits in front of the
# ALB. Production refuses to boot while this is unset or false.
TRUST_PROXY=1

AWS_REGION=ap-south-1
# Not applicable in production: supplying these makes the SDK prefer long-lived
# static keys over the ECS task role. Leave blank.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=vedhifoods-media-production
# Public base URL product images are served from. The media bucket is private
# behind CloudFront (OAC), so the raw S3 URL 403s. Set the distribution origin
# (no trailing slash). Leave blank only for a public-read bucket.
AWS_S3_PUBLIC_BASE_URL=https://cdn.vedhicfoods.com

# ElastiCache / VPC endpoint. Required: the default rate-limit store is per
# process, so across N tasks every limit silently becomes limit x N.
REDIS_URL=redis://REPLACE_ME_REDIS_HOST:6379

DATABASE_POOL_SIZE=5
DATABASE_CONNECT_TIMEOUT_S=10
DATABASE_SOCKET_TIMEOUT_S=30
DATABASE_PGBOUNCER=

# Leave blank when an ECS agent injects the secrets above. Set it only where there
# is no agent (EC2 without an agent, Beanstalk, App Runner).
SECRETS_MANAGER_SECRET_ID=

REQUEST_TIMEOUT_MS=60000
HEADERS_TIMEOUT_MS=66000
# Must exceed the ALB idle timeout so the *server* closes idle sockets first.
# If the ALB is left at the 60 s default, raise it above this value.
KEEP_ALIVE_TIMEOUT_MS=65000
# Must stay below the ECS `stopTimeout` (60 s).
SHUTDOWN_GRACE_MS=25000

EMAIL_PROVIDER=ses
SES_REGION=ap-south-1
# Must be on a domain verified in THIS account, or SES rejects the send.
SES_SENDER_EMAIL=orders@vedhicfoods.com
SES_SENDER_NAME=Vedhic Foods
# Without a configuration set, bounce and complaint events never reach
# CloudWatch and the bounce-rate alarm cannot be built.
SES_CONFIGURATION_SET=vedhicfoods

# Ops inbox for paid-order / failure alerts. Falls back to the SES sender when blank.
ADMIN_NOTIFICATION_EMAIL=orders@vedhicfoods.com

# SES bounce/complaint events are published to this SNS topic and delivered to
# /api/v1/webhooks/email/sns, which maintains the suppression list.
SNS_EMAIL_TOPIC_ARN=arn:aws:sns:ap-south-1:REPLACE_ME_ACCOUNT_ID:vedhicfoods-ses-events
SNS_VERIFY_SIGNATURE=true

# Durable email outbox. Keep true in production so queued invoice/order mail is
# not lost when a task is replaced during a deploy.
EMAIL_OUTBOX_ENABLED=true
EMAIL_OUTBOX_INTERVAL_MS=15000
EMAIL_OUTBOX_BATCH_SIZE=25

# Abandoned-checkout reservation reaper. Releases stock held by PENDING_PAYMENT
# orders older than RESERVATION_TTL_MS and cancels them.
RESERVATION_SWEEP_ENABLED=true
RESERVATION_TTL_MS=1800000
RESERVATION_SWEEP_INTERVAL_MS=300000
RESERVATION_SWEEP_BATCH=100

# Not applicable: SES is the production transport. Kept so a rollback to Brevo
# does not require discovering the variable name again.
BREVO_API_KEY=
# Brevo sender identity, retained for the same rollback parity. Blank here means
# the value must come from Secrets Manager if Brevo is ever re-enabled.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# OPTIONAL bootstrap fallback. Preferred: Admin -> Payment Settings (encrypted
# in the DB, no redeploy). Live mode: `rzp_live_*` keys charge real cards — test
# keys in production are worse than no keys, because they look configured. A
# placeholder here is detected and treated as absent, so boot still succeeds.
RAZORPAY_KEY_ID=rzp_live_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME

ENCRYPTION_KEY=REPLACE_ME_PRODUCTION_ENCRYPTION_KEY_min_32_chars
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=REPLACE_ME_PRODUCTION_PAYMENT_CREDENTIALS_KEY_min_32_chars

LOG_LEVEL=info