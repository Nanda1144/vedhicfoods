.env
.env.*
!.env.example
# Per-environment templates (.env.development.example, .env.staging.example, …).
# Without this negation the pattern above also ignores the examples, and the
# environment split silently stops being documented in the repository.
!.env.*.example
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
instance/
dist/
build/
*.egg-info/
uploads/
*.log
.DS_Store
.pg_data/
